{
  "name": "task-manager_node-express-db",
  "version": "1.0.0",
  "description": "task-manager server with mongoose or sequelize",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": "18.18.0",
    "npm": "9.8.1"
  },
  "imports": {
    "#utils/*": "./src/utils/*",
    "#middlewares/*": "./src/middlewares/*",
    "#configs/*": "./src/configs/*",
    "#routers/*": "./src/routers/*",
    "#models/*": "./src/models/*",
    "#controllers/*": "./src/controllers/*",
    "#services/*": "./src/services/*",
    "#types/*": "./src/types/*",
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "clean": "npm cache clean --force",
    "dev:insecure": "npm run dev -- --mode no-auth no-roles",
    "setup": "node ./src/db/setup.js > setup.output.txt 2>&1",
    "start": "node ./src/index.js",
    "dev": "nodemon ./src/index.js"
  },
  "author": "no4kar",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.4",
    "nodemailer": "^6.9.14",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.15.6",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.6.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.15.2",
    "@types/nodemailer": "^6.4.15",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pg": "^8.11.14",
    "@types/sequelize": "^4.28.20",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.15.0",
    "eslint": "^9.6.0",
    "globals": "^15.8.0",
    "nodemon": "^3.1.0",
    "typescript": "^5.5.3"
  }
}